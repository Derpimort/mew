{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MEW",
  "version": "0.3.0",
  "identifier": "com.derpimort.mew",
  "build": {
    "beforeDevCommand": "pnpm --dir ../app dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../app install --frozen-lockfile && pnpm --dir ../app build",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MEW — My Entire Week",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 740,
        "center": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' https://accounts.google.com; font-src 'self'; img-src 'self' data: https://*.gstatic.com; connect-src 'self' https://api.anthropic.com https://api.openai.com https://www.googleapis.com https://accounts.google.com http://localhost:11434 http://127.0.0.1:11434 http://localhost:3131 http://127.0.0.1:3131 http://127.0.0.1:*; frame-src https://accounts.google.com; base-uri 'self'; form-action 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "externalBin": [
      "binaries/gbrain"
    ],
    "targets": [
      "msi",
      "nsis",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/Derpimort/mew/releases/latest/download/latest.json"
      ]
    }
  }
}

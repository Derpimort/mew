{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least privilege: the SPA needs only the core window APIs, plus the auto-backup's narrow slice (fs strictly under $DOCUMENT/MEW, opener for that folder) and the calendar-connect slice (loopback start/cancel, opener for Google's auth origin only).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$DOCUMENT/MEW" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$DOCUMENT/MEW" }, { "path": "$DOCUMENT/MEW/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$DOCUMENT/MEW" }, { "path": "$DOCUMENT/MEW/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$DOCUMENT/MEW" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$DOCUMENT/MEW/**" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$DOCUMENT/MEW" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://accounts.google.com/*" }]
    },
    "oauth:allow-start",
    "oauth:allow-cancel"
  ]
}

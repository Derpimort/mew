{
  "name": "mew",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "audit": "osv-scanner scan source --lockfile pnpm-lock.yaml",
    "smoke:models": "MEW_SMOKE=1 vitest run src/adapters/model/__tests__/smoke.live.test.ts",
    "e2e": "playwright test",
    "shoot": "node scripts/shoot.mjs",
    "shoot:overlap": "node scripts/shoot-overlap.mjs",
    "shoot:onboarding": "node scripts/shoot-onboarding.mjs",
    "shoot:ritual": "node scripts/shoot-ritual.mjs",
    "shoot:scaffold": "node scripts/shoot-scaffold.mjs",
    "prepare": "cd .. && husky || true"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.37",
    "@ai-sdk/openai": "^4.0.37",
    "@ai-sdk/openai-compatible": "^3.0.29",
    "@noble/ciphers": "^2.3.0",
    "@noble/post-quantum": "^0.6.1",
    "ai": "^7.0.59",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "playwright-core": "1.62.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.15.9"
}
